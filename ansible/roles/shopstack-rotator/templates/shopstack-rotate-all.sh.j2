#!/bin/bash
# 🤖 Autogenerated by ClawBot
# Master rotation script for ShopStack customers.

INVENTORY_DIR="/opt/shopstack-rotator/shopstack/ansible/inventory/customers"
PLAYBOOK="/opt/shopstack-rotator/shopstack/ansible/rotate-credentials.yml"

echo "Starting ShopStack credential rotation at $(date)"

if [ ! -d "$INVENTORY_DIR" ]; then
    echo "Inventory directory $INVENTORY_DIR not found. Exiting."
    exit 1
fi

for customer_file in "$INVENTORY_DIR"/*.yml; do
  [ -e "$customer_file" ] || continue
  customer_name=$(basename "$customer_file" .yml)
  echo "--- Rotating $customer_name ---"
  # Run Ansible using the root's local shopstack_hub key for persistence encryption
  ansible-playbook "$PLAYBOOK" -i "$customer_file" \
    --extra-vars "customer_name=$customer_name secrets_dir=/opt/shopstack-rotator/secrets"
done

echo "Rotation completed at $(date)"
