# /opt/vaultwarden/.env — generated by Ansible, never committed to git
# Re-run `make vaultwarden` to regenerate (existing ADMIN_TOKEN is preserved).

## Core
DOMAIN=https://vault.woodhead.tech
ROCKET_PORT=80

## Admin panel (Authentik handles the SSO gate at Traefik; this token is the
## second-factor inside the Vaultwarden admin UI itself)
ADMIN_TOKEN={{ vaultwarden_admin_token }}

## Signups — disable after creating your account
SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | default('true') }}
SIGNUPS_VERIFY=false

## Invitations (org admin can still invite even with signups off)
INVITATIONS_ALLOWED=true

## Email / SMTP (Mailcow at 192.168.86.34)
SMTP_HOST=192.168.86.34
SMTP_FROM={{ vaultwarden_smtp_from | default('bwoodwar@woodhead.tech') }}
SMTP_FROM_NAME=Vaultwarden
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_USERNAME={{ vaultwarden_smtp_user }}
SMTP_PASSWORD={{ vaultwarden_smtp_password }}
# Mailcow uses a self-signed cert internally; skip peer verification for LAN SMTP
SMTP_ACCEPT_INVALID_CERTS=true

## Logging
LOG_LEVEL=warn
EXTENDED_LOGGING=true

## Push notifications (disabled — requires Bitwarden cloud relay)
PUSH_ENABLED=false
