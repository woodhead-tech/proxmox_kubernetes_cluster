# Required vars for: make libby-alert
# Copy to libby-alert.env and fill in values.
# Source before running: set -a && source scripts/secrets/libby-alert.env && make libby-alert

TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1XXXXXXXXXX
ALERT_PHONES=+1XXXXXXXXXX,+1XXXXXXXXXX
DISCORD_WEBHOOK=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_URL
