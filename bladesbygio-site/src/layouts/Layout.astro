---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = 'NorthWest Tactical Knives — SOG authorized dealer and master knife sharpening in the Pacific Northwest. Precision edges, custom engraving, and expert gear advice.',
  ogImage = '/og-default.jpg',
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const pageTitle = `${title} — NorthWest Tactical Knives`;

// Nav is a real sequence of what the shop does: bring an edge back, personalize it,
// buy the gear, meet the maker, come in.
const navLinks = [
  { href: '/services', label: 'Sharpening' },
  { href: '/custom', label: 'Custom Work' },
  { href: '/about', label: 'The Shop' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="NorthWest Tactical Knives" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700;800&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink:      #0B0E10;   /* base near-black, from the storefront sign */
      --ink2:     #101519;   /* raised surface */
      --panel:    #161C21;   /* card surface */
      --panel2:   #1D242A;
      --line:     rgba(255, 255, 255, 0.09);
      --line-gold: rgba(199, 154, 75, 0.28);
      --bone:     #ECE7DB;   /* warm off-white — the etched-gold highlight */
      --dim:      #C6C3B8;
      --muted:    #8C9299;
      --brass:    #C79A4B;   /* the emblem gold — primary accent */
      --brass-lt: #E7C77E;
      --brass-dk: #A67C34;
      --pine:     #16211C;   /* deep evergreen — a whisper of the Northwest */
      --steel:    #A9BCCB;   /* cold honed-edge highlight, used sparingly */
      --font-display: 'Saira Condensed', 'Arial Narrow', sans-serif;
      --font-body:    'Manrope', system-ui, -apple-system, sans-serif;
      --font-mono:    'IBM Plex Mono', monospace;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--ink);
      color: var(--bone);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    ::selection { background: rgba(199, 154, 75, 0.28); color: var(--bone); }

    /* ── The honed edge: a hairline that runs like a sharpened bevel ── */
    .edge-rule {
      height: 1px;
      border: 0;
      background: linear-gradient(90deg, transparent, var(--brass) 12%, var(--brass-lt) 50%, var(--brass) 88%, transparent);
      opacity: 0.7;
    }

    /* ── Compass eyebrow: N • label • S, echoing the shop's compass badge ── */
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--brass);
    }
    .eyebrow::before,
    .eyebrow::after {
      content: "";
      width: 22px;
      height: 1px;
      background: var(--line-gold);
    }

    /* ── Nav ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(11, 14, 16, 0.82);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }

    .nav-inner {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 68px;
      gap: 2rem;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      text-decoration: none;
      color: var(--bone);
      flex-shrink: 0;
    }

    .nav-brand svg { flex-shrink: 0; }

    .nav-brand-text { display: flex; flex-direction: column; line-height: 1; }

    .nav-brand-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.02rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bone);
    }

    .nav-brand-sub {
      font-family: var(--font-mono);
      font-size: 0.56rem;
      font-weight: 500;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--brass);
      margin-top: 3px;
    }

    .nav-links { display: flex; align-items: center; gap: 0.15rem; list-style: none; }

    .nav-links a {
      font-family: var(--font-display);
      font-size: 0.98rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      text-decoration: none;
      padding: 0.4rem 0.85rem;
      border-radius: 2px;
      transition: color 0.15s;
    }

    .nav-links a:hover { color: var(--bone); }
    .nav-links a.active { color: var(--brass); }

    .nav-cta {
      font-family: var(--font-display) !important;
      background: var(--brass) !important;
      color: var(--ink) !important;
      font-weight: 700 !important;
      font-size: 0.95rem !important;
      letter-spacing: 0.06em !important;
      text-transform: uppercase !important;
      padding: 0.5rem 1.05rem !important;
      border-radius: 2px !important;
      transition: background 0.15s !important;
    }
    .nav-cta:hover { background: var(--brass-lt) !important; color: var(--ink) !important; }

    main { flex: 1; }

    /* ── Footer ── */
    footer {
      border-top: 1px solid var(--line);
      background: var(--ink2);
      padding: 3rem 2rem 2.25rem;
    }
    .footer-inner {
      max-width: 1140px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 2.5rem;
    }
    .footer-brand-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--bone);
      margin-bottom: 0.5rem;
    }
    .footer-blurb { font-size: 0.85rem; color: var(--muted); line-height: 1.7; max-width: 34ch; }
    .footer-col h4 {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--brass);
      margin-bottom: 0.9rem;
      font-weight: 500;
    }
    .footer-col a, .footer-col p {
      display: block;
      font-size: 0.88rem;
      color: var(--dim);
      text-decoration: none;
      margin-bottom: 0.5rem;
      transition: color 0.15s;
    }
    .footer-col a:hover { color: var(--brass); }
    .footer-bottom {
      max-width: 1140px;
      margin: 2.25rem auto 0;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.04em;
    }

    /* ── Shared utilities ── */
    .container { max-width: 1140px; margin: 0 auto; padding: 0 2rem; }
    .section { padding: 6rem 0; }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      color: var(--bone);
      font-weight: 700;
      line-height: 1.02;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }

    .section-title { font-size: clamp(1.9rem, 4vw, 3rem); }
    .lead { color: var(--dim); font-size: 1.05rem; line-height: 1.75; font-family: var(--font-body); text-transform: none; }

    .accent { color: var(--brass); }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.8rem 1.5rem;
      border-radius: 2px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.15s;
      border: 1px solid transparent;
      white-space: nowrap;
    }
    .btn-primary { background: var(--brass); color: var(--ink); }
    .btn-primary:hover { background: var(--brass-lt); transform: translateY(-1px); }
    .btn-outline { background: transparent; color: var(--bone); border-color: var(--line-gold); }
    .btn-outline:hover { border-color: var(--brass); color: var(--brass); }

    /* ── Spec tag: the language of the trade (steel, angle, finish) ── */
    .spec {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--dim);
      background: var(--ink);
      border: 1px solid var(--line);
      padding: 0.22rem 0.55rem;
      border-radius: 2px;
      white-space: nowrap;
    }
    .spec-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }

    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 3px;
      padding: 1.9rem;
      transition: border-color 0.18s, transform 0.18s;
    }

    /* ── Hamburger ── */
    .nav-hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      width: 42px; height: 42px;
      border: none; background: transparent; cursor: pointer; padding: 0;
      border-radius: 2px; gap: 5px;
    }
    .nav-hamburger span {
      display: block; width: 22px; height: 2px; background: var(--brass);
      transition: transform 0.2s, opacity 0.2s; transform-origin: center;
    }
    .nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-hamburger.open span:nth-child(2) { opacity: 0; }
    .nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nav-mobile { display: none; position: fixed; top: 68px; left: 0; right: 0; bottom: 0; z-index: 99; }
    .nav-mobile-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.55); }
    .nav-mobile-panel {
      position: absolute; top: 0; left: 0; right: 0;
      background: var(--ink2);
      border-bottom: 1px solid var(--line-gold);
      padding: 1rem 1.5rem 1.75rem;
      display: flex; flex-direction: column; gap: 0.25rem;
    }
    .nav-mobile-panel a {
      font-family: var(--font-display);
      font-size: 1.15rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;
      color: var(--dim); text-decoration: none; padding: 0.7rem 0.5rem;
      border-bottom: 1px solid var(--line);
    }
    .nav-mobile-panel a:last-child { border-bottom: none; }
    .nav-mobile-panel a.active { color: var(--brass); }
    .nav-mobile-panel .nav-cta { margin-top: 0.75rem; text-align: center; border-bottom: none; }
    .nav-mobile.open { display: block; }

    @media (max-width: 820px) {
      .nav-links { display: none; }
      .nav-hamburger { display: flex; }
      .section { padding: 4rem 0; }
      .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
    }

    :focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }
  </style>
</head>
<body>
  <nav>
    <div class="nav-inner">
      <a href="/" class="nav-brand" aria-label="NorthWest Tactical Knives — home">
        <svg width="34" height="34" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="24" cy="24" r="21" stroke="#C79A4B" stroke-width="1.5"/>
          <!-- compass ticks: N emphasized -->
          <path d="M24 4 L24 11" stroke="#E7C77E" stroke-width="2"/>
          <path d="M24 37 L24 44" stroke="#C79A4B" stroke-width="1.5"/>
          <path d="M4 24 L11 24" stroke="#C79A4B" stroke-width="1.5"/>
          <path d="M37 24 L44 24" stroke="#C79A4B" stroke-width="1.5"/>
          <!-- crossed blades -->
          <path d="M15 32 L30 15 L33 17 L18 34 Z" fill="#C79A4B" opacity="0.9"/>
          <path d="M33 32 L18 15 L15 17 L30 34 Z" fill="#C79A4B" opacity="0.55"/>
          <!-- mountain node -->
          <path d="M20 26 L24 20 L28 26 Z" fill="#0B0E10" stroke="#E7C77E" stroke-width="1.2"/>
        </svg>
        <div class="nav-brand-text">
          <span class="nav-brand-name">NorthWest Tactical Knives</span>
          <span class="nav-brand-sub">SOG Authorized Dealer</span>
        </div>
      </a>
      <ul class="nav-links">
        {navLinks.map((l) => (
          <li><a href={l.href} class:list={[{ active: currentPath.startsWith(l.href) }]}>{l.label}</a></li>
        ))}
        <li><a href="/contact" class="nav-cta">Visit the Shop</a></li>
      </ul>
      <button class="nav-hamburger" aria-label="Toggle menu" aria-expanded="false" id="nav-toggle">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="nav-mobile" id="nav-mobile" aria-hidden="true">
    <div class="nav-mobile-backdrop" id="nav-backdrop"></div>
    <div class="nav-mobile-panel">
      {navLinks.map((l) => (
        <a href={l.href} class:list={[{ active: currentPath.startsWith(l.href) }]}>{l.label}</a>
      ))}
      <a href="/contact" class="nav-cta">Visit the Shop</a>
    </div>
  </div>

  <main><slot /></main>

  <footer>
    <div class="footer-inner">
      <div>
        <div class="footer-brand-name">NorthWest Tactical Knives</div>
        <p class="footer-blurb">
          SOG authorized dealer and master knife sharpening in the Pacific Northwest.
          Bring in a dull blade, leave with a keen edge.
        </p>
      </div>
      <div class="footer-col">
        <h4>The Shop</h4>
        <a href="/services">Sharpening</a>
        <a href="/custom">Custom Work</a>
        <a href="/about">The Shop</a>
        <a href="/contact">Visit / Contact</a>
      </div>
      <div class="footer-col">
        <h4>Get in Touch</h4>
        <p id="footer-phone">Call or text — see Contact</p>
        <a href="/contact">Hours &amp; directions</a>
        <a href="https://www.facebook.com/" target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} NorthWest Tactical Knives</span>
      <span>Master sharpening · SOG dealer · Custom engraving</span>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-mobile');
    const backdrop = document.getElementById('nav-backdrop');
    function openMenu() {
      toggle?.classList.add('open'); menu?.classList.add('open');
      toggle?.setAttribute('aria-expanded', 'true'); menu?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeMenu() {
      toggle?.classList.remove('open'); menu?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    toggle?.addEventListener('click', () => menu?.classList.contains('open') ? closeMenu() : openMenu());
    backdrop?.addEventListener('click', closeMenu);
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  </script>
</body>
</html>
