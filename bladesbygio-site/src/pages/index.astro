---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Master Sharpening & SOG Knives — Lynnwood, WA">

  <!-- ══ Hero ══ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="eyebrow">Lynnwood, WA · Master Sharpening</span>
        <h1>Bring it back<br />to a <span class="accent">keen edge.</span></h1>
        <p class="lead hero-lead">
          NorthWest Tactical Knives is a full-service knife shop and the largest SOG
          authorized dealer in the Northwest. Owner Gio Guajardo has spent over a decade
          putting a true factory edge — often sharper — on the knives, tools, and cutlery
          you carry every day.
        </p>
        <div class="hero-cta">
          <a href="/contact" class="btn btn-primary">Visit the Shop →</a>
          <a href="/services" class="btn btn-outline">Sharpening &amp; Prices</a>
        </div>
        <div class="hero-trust">
          <span>SOG Authorized Dealer</span>
          <span class="dot">•</span>
          <span>Every edge by hand</span>
          <span class="dot">•</span>
          <span>10+ years in the Northwest</span>
        </div>
      </div>
      <div class="hero-media">
        <img src="/images/logo-blade.jpg" alt="A black tactical blade laser-etched with the NorthWest Tactical Knives compass logo in gold" width="1600" height="1200" loading="eager" />
        <div class="hero-media-tag spec">NorthWest Tactical Knives · Lynnwood, WA</div>
      </div>
    </div>
  </section>

  <hr class="edge-rule" />

  <!-- ══ What we do ══ -->
  <section class="section">
    <div class="container">
      <div class="block-head">
        <span class="eyebrow">What we do</span>
        <h2 class="section-title">Three reasons to walk in.</h2>
      </div>

      <div class="offer-grid">
        <a href="/services" class="card offer-card">
          <div class="offer-media"><img src="/images/terminus-lineup.jpg" alt="A row of SOG Terminus XR folding knives" width="800" height="600" loading="lazy" /></div>
          <div class="offer-body">
            <h3>Sharpening</h3>
            <p>A true factory edge on pocket knives, hunters, tactical blades, and the whole kitchen block. Dull to shaving-sharp while you shop.</p>
            <div class="spec-row">
              <span class="spec">SOG $13</span>
              <span class="spec">Other brands $15</span>
              <span class="spec">Cutlery $1/in</span>
            </div>
            <span class="offer-link">See sharpening →</span>
          </div>
        </a>

        <a href="/custom" class="card offer-card">
          <div class="offer-media"><img src="/images/custom-engraving.jpg" alt="A SOG Trident folding knife laser-engraved with BEST DAD EVER" width="800" height="600" loading="lazy" /></div>
          <div class="offer-body">
            <h3>Custom Work</h3>
            <p>Make it yours. Laser engraving for names and gifts, custom serrations cut to your grind, and repairs on the gear you already trust.</p>
            <div class="spec-row">
              <span class="spec">Engraving $15</span>
              <span class="spec">Custom serrations</span>
              <span class="spec">Repairs</span>
            </div>
            <span class="offer-link">See custom work →</span>
          </div>
        </a>

        <a href="/about" class="card offer-card">
          <div class="offer-media"><img src="/images/case-folders.jpg" alt="A lit glass display case full of SOG folding knives" width="800" height="600" loading="lazy" /></div>
          <div class="offer-body">
            <h3>Shop SOG</h3>
            <p>Folders to fixed blades, tomahawks, multi-tools, and packs — the deepest SOG selection in the region, with someone who actually carries them behind the counter.</p>
            <div class="spec-row">
              <span class="spec">Folders</span>
              <span class="spec">Fixed blades</span>
              <span class="spec">Tools &amp; gear</span>
            </div>
            <span class="offer-link">About the shop →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ Signature band ══ -->
  <section class="band">
    <div class="container band-inner">
      <div class="band-mark" aria-hidden="true">N<span>·</span>S</div>
      <p class="band-quote">
        “The edge isn't a nice-to-have. It's the whole tool. Bring me a blade you'd
        given up on — I'll hand it back better than the day you bought it.”
      </p>
      <p class="band-attr">— Gio Guajardo, owner &amp; sharpener</p>
    </div>
  </section>

  <!-- ══ Gallery preview ══ -->
  <section class="section">
    <div class="container">
      <div class="block-head">
        <span class="eyebrow">From the case</span>
        <h2 class="section-title">Blades worth showing off.</h2>
      </div>
      <div class="gallery-preview">
        <a href="/custom" class="gp gp-tall"><img src="/images/collector-tigerstripe.jpg" alt="A collector SOG folder with a tiger-stripe camo blade in a case" width="800" height="1066" loading="lazy" /></a>
        <a href="/custom" class="gp"><img src="/images/aegis-stand.jpg" alt="Four SOG Aegis folding knives on a display stand" width="800" height="600" loading="lazy" /></a>
        <a href="/custom" class="gp"><img src="/images/collector-case.jpg" alt="A limited-edition SOG knife and challenge coin in a hard case" width="800" height="600" loading="lazy" /></a>
        <a href="/custom" class="gp gp-wide"><img src="/images/heritage-wall.jpg" alt="A wall of SOG products and vintage knife magazine covers" width="800" height="600" loading="lazy" /></a>
      </div>
      <div class="center-cta">
        <a href="/custom" class="btn btn-outline">See the full gallery →</a>
      </div>
    </div>
  </section>

  <hr class="edge-rule" />

  <!-- ══ Owner band ══ -->
  <section class="section">
    <div class="container owner-grid">
      <div class="owner-media">
        <img src="/images/owner-gio.jpg" alt="Gio Guajardo behind the counter at NorthWest Tactical Knives" width="1200" height="900" loading="lazy" />
      </div>
      <div class="owner-text">
        <span class="eyebrow">Behind the counter</span>
        <h2 class="section-title">You're buying from the sharpener.</h2>
        <p class="lead">
          No big-box counter, no guesswork. Gio has run NorthWest Tactical Knives for
          years, sharpening and repairing blades long enough to know exactly what a good
          edge should feel like. Ask a question and you'll get a straight answer from the
          person who put the edge on it.
        </p>
        <a href="/about" class="btn btn-outline">Meet the shop →</a>
      </div>
    </div>
  </section>

  <!-- ══ Visit CTA ══ -->
  <section class="visit">
    <div class="container visit-inner">
      <h2 class="visit-title">Dull blade? Bring it in.</h2>
      <p class="visit-sub">Walk-ins welcome during shop hours. Call or text ahead for larger jobs.</p>
      <div class="visit-facts">
        <div class="vf"><span class="vf-label">Hours</span><span class="vf-val">Mon–Fri · 10:00–5:30</span></div>
        <div class="vf"><span class="vf-label">Call or text</span><a class="vf-val" href="tel:+14255990661">425-599-0661</a></div>
        <div class="vf"><span class="vf-label">Where</span><span class="vf-val">Lynnwood, WA</span></div>
      </div>
      <a href="/contact" class="btn btn-primary">Hours, directions &amp; contact →</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .hero { padding: 5.5rem 0 4.5rem; position: relative; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1.4rem; }
  .hero h1 {
    font-size: clamp(3rem, 7vw, 5.25rem);
    line-height: 0.94;
    letter-spacing: 0.005em;
  }
  .hero-lead { max-width: 46ch; }
  .hero-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.3rem; }
  .hero-trust {
    display: flex; align-items: center; flex-wrap: wrap; gap: 0.55rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em;
    color: var(--muted); margin-top: 0.4rem;
  }
  .hero-trust .dot { color: var(--brass); }

  .hero-media { position: relative; }
  .hero-media img {
    width: 100%; height: 100%; max-height: 460px; object-fit: cover;
    border: 1px solid var(--line-gold); border-radius: 3px; display: block;
    box-shadow: 0 24px 60px rgba(0,0,0,0.5);
  }
  .hero-media-tag { position: absolute; left: 0.9rem; bottom: 0.9rem; background: rgba(11,14,16,0.9); }

  /* ── Section heads ── */
  .block-head { margin-bottom: 2.75rem; display: flex; flex-direction: column; gap: 0.85rem; }

  /* ── Offer grid ── */
  .offer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
  .offer-card { padding: 0; overflow: hidden; text-decoration: none; display: flex; flex-direction: column; }
  .offer-card:hover { border-color: var(--line-gold); transform: translateY(-3px); }
  .offer-media { aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 1px solid var(--line); }
  .offer-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .offer-card:hover .offer-media img { transform: scale(1.04); }
  .offer-body { padding: 1.5rem 1.6rem 1.7rem; display: flex; flex-direction: column; gap: 0.85rem; flex: 1; }
  .offer-body h3 { font-size: 1.5rem; }
  .offer-body p { font-size: 0.92rem; color: var(--dim); line-height: 1.65; flex: 1; }
  .offer-link {
    font-family: var(--font-display); font-weight: 700; font-size: 0.95rem;
    letter-spacing: 0.05em; text-transform: uppercase; color: var(--brass); margin-top: 0.2rem;
  }

  /* ── Signature band ── */
  .band { background: var(--pine); border-top: 1px solid var(--line-gold); border-bottom: 1px solid var(--line-gold); }
  .band-inner { padding: 4.5rem 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .band-mark {
    font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.4em;
    color: var(--brass); border: 1px solid var(--line-gold); border-radius: 999px;
    width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;
  }
  .band-mark span { color: var(--brass-lt); margin: 0 1px; }
  .band-quote {
    font-family: var(--font-display); font-weight: 600; text-transform: uppercase;
    font-size: clamp(1.4rem, 3vw, 2.15rem); line-height: 1.2; letter-spacing: 0.01em;
    max-width: 22ch; color: var(--bone);
  }
  .band-attr { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.08em; color: var(--brass); }

  /* ── Gallery preview ── */
  .gallery-preview {
    display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 200px; gap: 0.75rem;
  }
  .gp { overflow: hidden; border: 1px solid var(--line); border-radius: 3px; display: block; }
  .gp img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s, filter 0.3s; filter: saturate(0.92); }
  .gp:hover img { transform: scale(1.05); filter: saturate(1.05); }
  .gp-tall { grid-row: span 2; }
  .gp-wide { grid-column: span 2; }
  .center-cta { text-align: center; margin-top: 2rem; }

  /* ── Owner band ── */
  .owner-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3.5rem; align-items: center; }
  .owner-media img { width: 100%; border: 1px solid var(--line-gold); border-radius: 3px; display: block; }
  .owner-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }

  /* ── Visit CTA ── */
  .visit { background: var(--ink2); border-top: 1px solid var(--line); }
  .visit-inner { padding: 4.5rem 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .visit-title { font-size: clamp(2rem, 4.5vw, 3.25rem); }
  .visit-sub { color: var(--muted); font-size: 1rem; }
  .visit-facts { display: flex; gap: 2.5rem; flex-wrap: wrap; justify-content: center; margin: 1rem 0 1.5rem; }
  .vf { display: flex; flex-direction: column; gap: 0.3rem; }
  .vf-label { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brass); }
  .vf-val { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; color: var(--bone); text-decoration: none; }
  a.vf-val:hover { color: var(--brass); }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero { padding: 3rem 0 3.5rem; }
    .hero-media { order: -1; }
    .hero-media img { max-height: 320px; }
    .offer-grid { grid-template-columns: 1fr; }
    .owner-grid { grid-template-columns: 1fr; gap: 2rem; }
    .owner-media { order: -1; }
    .gallery-preview { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; }
    .gp-wide { grid-column: span 2; }
    .gp-tall { grid-row: span 1; }
    .visit-facts { gap: 1.75rem; }
  }
</style>
