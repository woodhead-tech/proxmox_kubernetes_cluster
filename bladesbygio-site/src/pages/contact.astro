---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Visit & Contact" description="Visit NorthWest Tactical Knives in Lynnwood, WA. Open Mon–Fri 10:00–5:30. Call or text 425-599-0661 for sharpening, custom work, and SOG knives.">

  <section class="phead">
    <div class="container">
      <span class="eyebrow">Visit &amp; contact</span>
      <h1 class="phead-title">Come get<br /><span class="accent">a good edge.</span></h1>
      <p class="lead phead-lead">
        Walk in during shop hours — most sharpening is done while you browse the case. For
        larger jobs, cutlery sets, repairs, or custom work, call or text ahead so Gio can
        set aside the time.
      </p>
    </div>
  </section>

  <hr class="edge-rule" />

  <section class="section">
    <div class="container contact-grid">

      <!-- Contact methods -->
      <div class="contact-methods">
        <a class="method card" href="tel:+14255990661">
          <span class="method-label">Call or text</span>
          <span class="method-val">425-599-0661</span>
          <span class="method-note">Fastest way to reach the shop</span>
        </a>
        <a class="method card" href="mailto:gguajardo34@yahoo.com">
          <span class="method-label">Email</span>
          <span class="method-val">gguajardo34@yahoo.com</span>
          <span class="method-note">Quotes, custom jobs &amp; questions</span>
        </a>
        <div class="method card">
          <span class="method-label">Where</span>
          <span class="method-val">Lynnwood, WA</span>
          <span class="method-note">Recently moved — call or text for the current location before your first visit.</span>
        </div>
      </div>

      <!-- Hours + what to bring -->
      <div class="contact-side">
        <div class="hours card">
          <h3>Shop hours</h3>
          <ul class="hours-list">
            <li><span>Monday</span><span>10:00 – 5:30</span></li>
            <li><span>Tuesday</span><span>10:00 – 5:30</span></li>
            <li><span>Wednesday</span><span>10:00 – 5:30</span></li>
            <li><span>Thursday</span><span>10:00 – 5:30</span></li>
            <li><span>Friday</span><span>10:00 – 5:30</span></li>
            <li class="closed"><span>Sat / Sun</span><span>Closed</span></li>
          </ul>
        </div>

        <div class="bring card">
          <h3>What to bring</h3>
          <ul class="bring-list">
            <li>The knives or tools you want sharpened — any brand, any condition.</li>
            <li>For engraving: the exact name, text, or artwork you want.</li>
            <li>For repairs: the blade plus anything that came loose or broke.</li>
            <li>Not sure it's salvageable? Bring it anyway — that's the fun part.</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <section class="visit">
    <div class="container visit-inner">
      <div class="band-mark" aria-hidden="true">N<span>·</span>S</div>
      <h2 class="visit-title">See you at the counter.</h2>
      <p class="visit-sub">NorthWest Tactical Knives · Lynnwood, WA · SOG Authorized Dealer</p>
      <a href="tel:+14255990661" class="btn btn-primary">Call 425-599-0661 →</a>
    </div>
  </section>

</Layout>

<style>
  .phead { padding: 4.5rem 0 3rem; }
  .phead-title { font-size: clamp(2.75rem, 6.5vw, 4.75rem); line-height: 0.95; margin: 1rem 0 1.4rem; }
  .phead-lead { max-width: 56ch; }

  .contact-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: start; }

  .contact-methods { display: flex; flex-direction: column; gap: 1rem; }
  .method { display: flex; flex-direction: column; gap: 0.4rem; text-decoration: none; border-left: 2px solid var(--brass); }
  a.method:hover { border-color: var(--line-gold); }
  a.method:hover .method-val { color: var(--brass-lt); }
  .method-label { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brass); }
  .method-val { font-family: var(--font-display); font-size: 1.7rem; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; color: var(--bone); transition: color 0.15s; word-break: break-word; }
  .method-note { font-size: 0.86rem; color: var(--muted); line-height: 1.5; }

  .contact-side { display: flex; flex-direction: column; gap: 1rem; }
  .hours h3, .bring h3 { font-size: 1.35rem; margin-bottom: 1rem; }
  .hours-list { list-style: none; display: flex; flex-direction: column; }
  .hours-list li {
    display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0;
    border-bottom: 1px solid var(--line); font-size: 0.92rem;
  }
  .hours-list li span:first-child { color: var(--dim); }
  .hours-list li span:last-child { font-family: var(--font-mono); font-size: 0.82rem; color: var(--bone); }
  .hours-list li:last-child { border-bottom: none; }
  .hours-list .closed span { color: var(--muted); }

  .bring-list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .bring-list li { font-size: 0.9rem; color: var(--dim); line-height: 1.55; padding-left: 1.25rem; position: relative; }
  .bring-list li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 7px; height: 7px; background: var(--brass); transform: rotate(45deg); }

  .visit { background: var(--ink2); border-top: 1px solid var(--line); }
  .visit-inner { padding: 4.5rem 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .band-mark {
    font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.4em;
    color: var(--brass); border: 1px solid var(--line-gold); border-radius: 999px;
    width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;
  }
  .band-mark span { color: var(--brass-lt); margin: 0 1px; }
  .visit-title { font-size: clamp(2rem, 4.5vw, 3.25rem); }
  .visit-sub { color: var(--muted); font-size: 0.92rem; font-family: var(--font-mono); letter-spacing: 0.04em; }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
