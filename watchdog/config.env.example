# watchdog config — copy to config.env and fill in secrets
# config.env is gitignored

# Discord webhook for watchdog notifications (required)
DISCORD_WEBHOOK=""

# SSH key path (on the host running the watchdog)
SSH_KEY="/root/.ssh/id_ansible"

# Proxmox nodes
PVE1_IP="192.168.86.29"

# LXC IPs
TRAEFIK_IP="192.168.86.20"
ARR_STACK_IP="192.168.86.22"
MONITORING_IP="192.168.86.25"
AUTHENTIK_IP="192.168.86.28"
ADGUARD_IP="192.168.86.35"

# NFS
ARR_NFS_MOUNT="/mnt/truenas-media"
NFS_CHECK_TIMEOUT="15"

# Klipper
KLIPPER_ENDER3_IP="192.168.86.138"
KLIPPER_ENDER5PRO_IP="192.168.86.136"

# Kubernetes
K8S_VIP_IP="192.168.86.100"
TALOSCONFIG_PATH=""  # optional: path to talosconfig if available on watchdog host

# Ceph slow op threshold before OSD restart (seconds)
CEPH_SLOW_OP_AGE_SECONDS="1800"
